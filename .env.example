# Database
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Security
SECRET_KEY=your-secret-key-here-generate-a-long-random-string

# Flask
FLASK_ENV=production
FLASK_DEBUG=False

# Stripe (get from https://dashboard.stripe.com/apikeys)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Other API keys (optional - configure in admin panel)
# CLOUDINARY_API_KEY=
# MAPBOX_TOKEN=
# SENDGRID_API_KEY=

# Email (Flask-Mail) — required for signup confirmation + password reset.
# See EMAIL_SETUP.md for the two supported options (SendGrid SMTP relay or
# a Gmail app password). If MAIL_SERVER is left unset, the app still runs
# but no emails are sent and new accounts must be verified manually by an
# admin. Never commit real credentials — these live in the server .env only.
MAIL_SERVER=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=apikey
MAIL_PASSWORD=your-sendgrid-api-key-here
MAIL_DEFAULT_SENDER=noreply@paid2match.work
